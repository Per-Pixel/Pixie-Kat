# AWS Elastic Beanstalk production environment configuration
# Elastic Beanstalk provides PORT automatically. Keep this for local production testing.
PORT=5000
NODE_ENV=production

# Frontend URL used in password reset redirect links
FRONTEND_URL=https://pixiekat.store

# Comma-separated browser origins that can call this API in production.
CORS_ORIGINS=https://pixiekat.store,https://admin.pixiekat.store

# Supabase service credentials. Store the service role key as an AWS secret.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Comma-separated list of users who can manage other admin wallets and other elevated ops.
# Use the admin user's profile UUID, email, or both.
# If left unset, no account has super-admin powers.
SUPER_ADMIN_IDS=
SUPER_ADMIN_EMAILS=

# Razorpay — store all three values as Elastic Beanstalk secrets
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_SUPPORTED_CURRENCIES=INR

# SmileCode API
SMILECODE_API_KEY=your-api-key
SMILECODE_CLIENT_ID=your-integration-id
SMILECODE_SECRET=your-secret-key

# Smilecoin API
SC_EMAIL=your-smileone-email@example.com
SC_UID=your-smileone-uid
SC_KEY=your-smileone-key
SC_COUNTRY=in
SC_ALLOW_TEST_ORDER=false

# Transactional email (order status + login alerts via notification_outbox).
# Hostinger mailbox credentials — store SMTP_PASS as an EB secret.
# If unset, the notification worker stays off and queued rows keep pending.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=admin@pixiekat.store
SMTP_PASS=your-mailbox-password
SMTP_FROM=Pixie-Kat <noreply@pixiekat.store>
